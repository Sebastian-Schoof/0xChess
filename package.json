{
    "name": "0xChess",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "client:start": "vite --config client/vite.config.ts",
        "client:build": "tsc --project client/tsconfig.json && vite build --config client/vite.config.ts",
        "client:build-embed": "tsc --project client/tsconfig.json && vite build --mode embed --config client/vite.config.ts",
        "client:preview": "vite preview --config client/vite.config.ts",
        "server:start": "tsx watch --tsconfig server/tsconfig.json server/main.ts",
        "server:build": "esbuild server/main.ts --bundle --packages=external --platform=node --target=node24 --minify --outfile=build/server.js",
        "start": "concurrently \"npm run client:start\" \"npm run server:start\"",
        "build": "concurrently \"npm run client:build\" \"npm run server:build\"",
        "initDB": "tsx --tsconfig server/tsconfig.json server/db/scripts/execute.ts"
    },
    "dependencies": {
        "@preact/signals": "^2.9.4",
        "better-sqlite3": "^12.11.1",
        "phaser": "^4.2.1",
        "preact": "^10.29.7",
        "ws": "^8.21.1"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "@types/ws": "^8.18.1",
        "concurrently": "^10.0.3",
        "esbuild": "^0.28.1",
        "npm-check-updates": "^22.2.9",
        "prettier": "^3.9.5",
        "sass": "^1.101.0",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2",
        "vite": "^8.1.4"
    }
}
